# Server port
PORT=4000

# Max upload size in megabytes
MAX_UPLOAD_MB=5

# Persistence toggle. v1 runs stateless. Set to true once a Postgres
# connection is wired up (see server/db/schema.sql).
PERSIST=false

# Postgres connection (only used when PERSIST=true)
# DATABASE_URL=postgres://user:password@localhost:5432/yourspotrented

# Airtable — main operations base (Refunds, Expenses, Towed Illegal Parker,
# Parkpliant Records, RingCentral Conversations, Weekly Report). The same key
# also authorizes reads against the separate SpotHero base (hardcoded id,
# override with SPOTHERO_BASE_ID only if it ever moves).
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app9iYUN8J3z2wjXN
# SPOTHERO_BASE_ID=appsO1gJ4xO36dVq6

# Resend — weekly report email delivery (Render free tier blocks SMTP, so this
# uses the Resend HTTPS API instead of nodemailer/SMTP).
RESEND_API_KEY=
# Comma-separated list of recipient email addresses.
REPORT_RECIPIENTS=
